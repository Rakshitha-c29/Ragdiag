# Copy to .env and fill in.

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://ragdiag:ragdiag@localhost:5432/ragdiag

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Storage
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
MAX_UPLOAD_MB=25

# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base
CLASSIFIER_MODEL_PATH=./models/failure_classifier
# Must match the text format the DistilBERT classifier was trained on.
CLASSIFIER_INPUT_TEMPLATE=Question: {question} Answer: {answer} Faithfulness: {faithfulness} Completeness: {completeness} Precision: {precision} Context: {context}

# Pipeline defaults
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# Load all ML models at startup instead of on the first request
WARM_MODELS=false
